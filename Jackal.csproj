<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Jackal</Title>
    <Authors>Ryan Rennoir</Authors>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <Description>Shared memory reader for Assetto Corsa Competizione</Description>
    <PackageProjectUrl>https://github.com/rrennoir/Jackal</PackageProjectUrl>
